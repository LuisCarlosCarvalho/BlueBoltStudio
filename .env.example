# Blue Bolt Page Studio - Environment Variables Reference

# 1. Neon PostgreSQL Database Connection String (from Neon Console or Vercel Integration)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
POSTGRES_URL=postgresql://user:password@host/neondb?sslmode=require

# 2. Session Secret (Required in Production - High-Entropy Random String)
SESSION_SECRET=generate-a-secure-random-string-with-at-least-32-characters
