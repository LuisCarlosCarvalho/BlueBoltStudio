# Blue Bolt Page Studio - Environment Variables

# Option A: Neon Postgres (Vercel Integration - Injected Automatically on Vercel)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
POSTGRES_URL=postgresql://user:password@host/neondb?sslmode=require
JWT_SECRET=your-random-secure-jwt-secret-key-min-32-chars

# Option B: Supabase (Legacy / Optional)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
